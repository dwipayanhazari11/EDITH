# ==========================================
# EDITH Environment Variables Template
# ==========================================

# Telegram Bot API Token (obtained via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_placeholder

# Google Gemini API Key (obtained from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=medium

# Public Webhook URL for Telegram and n8n (must be https, e.g. Cloudflare tunnel or custom domain)
WEBHOOK_URL=https://your-webhook-domain.example.com

# Google Sheet Database ID (from spreadsheet URL: /d/<GOOGLE_SHEET_ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_placeholder

# Timezone Configuration
GENERIC_TIMEZONE=Asia/Kolkata

# Optional Cloudflare Tunnel Token (if using authenticated tunnel instead of quick tunnel)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_placeholder
